import battlecode.common.Direction;
import battlecode.common.GameActionException;
import battlecode.common.MapInfo;
import battlecode.common.MapLocation;
import battlecode.common.RobotInfo;
import battlecode.common.TrapType;
import battlecode.common.UnitType;

import static awubot.Game.*;
import static awubot.util.Util.*;
import awubot.util.Profiler;
import awubot.CellTracker;
import awubot.RobotTracker;
import awubot.comms.Enemy;
import awubot.comms.EnemyManager;

public class CombatTracker {
    private static final int GRID_RADIUS = 2;

    {% macro cell_var(dx, dy) -%}
    t_{{ "m" if dx < 0 else "" }}{{ dx|abs }}_{{ "m" if dy < 0 else "" }}{{ dy|abs }}
    {%- endmacro %}

    {% macro long_hex(val) -%}
    0x{{ "%016x"|format(val) }}L
    {%- endmacro %}

    {% macro threat_expr(dx_m, dy_m) -%}
    {%- set ns = namespace(terms=[]) -%}
    {%- for i in range(8) -%}
    {%- set ndir = directions[i] -%}
    {%- set nx = dx_m + dir_dx[ndir] -%}
    {%- set ny = dy_m + dir_dy[ndir] -%}
    {%- set term = "(" ~ cell_var(nx, ny) ~ " ? " ~ long_hex(bitLeftShift(255, i * 8)) ~ " : 0L)" -%}
    {%- set ns.terms = ns.terms + [term] -%}
    {%- endfor -%}
    {%- if ns.terms|length == 0 -%}
    0L
    {%- else -%}
    {{ ns.terms | join(" | ") }}
    {%- endif -%}
    {%- endmacro %}

    {% macro enemy_mask(dx_e, dy_e, facing_idx, moveDir) -%}
    {%- set dx_m = dir_dx[moveDir] -%}
    {%- set dy_m = dir_dy[moveDir] -%}
    {%- set dx_rel = dx_m - dx_e -%}
    {%- set dy_rel = dy_m - dy_e -%}
    {%- set dist_ok = (dx_rel * dx_rel + dy_rel * dy_rel) <= 20 -%}
    {%- set ns = namespace(mask=0) -%}
    {%- set visible = (can_see(facing_idx, dx_rel, dy_rel) == "true") -%}
    {%- if dist_ok and visible -%}
    {%- for i in range(8) -%}
    {%- set ndir = directions[i] -%}
    {%- set nx = dx_m + dir_dx[ndir] -%}
    {%- set ny = dy_m + dir_dy[ndir] -%}
    {%- set adx = (nx - dx_e) | abs -%}
    {%- set ady = (ny - dy_e) | abs -%}
    {%- if adx <= 1 and ady <= 1 -%}
    {%- set ns.mask = bitOr(ns.mask, bitLeftShift(1, i * 8)) -%}
    {%- endif -%}
    {%- endfor -%}
    {%- endif -%}
    {{ long_hex(ns.mask) }}
    {%- endmacro %}

    {% macro add_mask(var, dx_e, dy_e, facing_idx, moveDir) -%}
    {%- set mask = enemy_mask(dx_e, dy_e, facing_idx, moveDir) -%}
    {%- if mask|trim != "0x0000000000000000L" -%}
    {{ var }} += {{ mask }};
    {%- endif -%}
    {%- endmacro %}

    // isThreat flags for the 5x5 around the player.
    {% for dy in range(2, -3, -1) %}
    {% for dx in range(-2, 3) %}
    private static boolean {{ cell_var(dx, dy) }};
    {% endfor %}
    {% endfor %}

    // Byte-packed enemy counters (low/high health) per move direction.
    {% for s in moveShort %}
    private static long low{{ s }};
    {% endfor %}
    {% for s in moveShort %}
    private static long high{{ s }};
    {% endfor %}

    // Byte-packed threat masks per move direction (0xFF per reachable neighbor).
    {% for s in moveShort %}
    private static long moveThreat{{ s }};
    {% endfor %}

    // Cached (combined & threat) per move/facing.
    {% for ms in moveShort %}
    {% for fs in shortDirections %}
    public static long threat{{ ms }}{{ fs }};
    {% endfor %}
    {% endfor %}

    // Hidden-neighbor masks per facing (0xFF for hidden, 0x00 for visible).
    {% for facing in directions %}
    {%- set ns = namespace(mask=0) -%}
    {%- for i in range(8) -%}
    {%- set dir = directions[i] -%}
    {%- if dir not in visible_dirs[facing] -%}
    {%- set ns.mask = bitOr(ns.mask, bitLeftShift(255, i * 8)) -%}
    {%- endif -%}
    {%- endfor -%}
    private static final long hidden{{ shortDirections[loop.index0] }} = {{ long_hex(ns.mask) }};
    {% endfor %}// indicate

    public static void tick() throws GameActionException {
        // // Profiler.push();
        loadThreatFromMap();
        // // Profiler.pop("CombatTracker: loading threats");

        // // Profiler.push();
        recomputeThreatMasks();
        // // Profiler.pop("CombatTracker: recomputing threat masks");

        resetEnemyCounts();
        
        // // Profiler.push();
        for (int i = 0; i < RobotTracker.numEnemies; i++) {
            RobotInfo info = RobotTracker.sortedEnemies[i];
            if (info.getType() != UnitType.BABY_RAT) continue;
            registerEnemy(new Enemy(info));
        }
        // be aware of squeaked danger (hopefully should reduce chance of getting napped while not blocking too many moves unnecessarily)
        for (int i = 0; i < EnemyManager.numKnownEnemies; i++) {
            Enemy enemy = EnemyManager.knownEnemies[i];
            registerEnemy(enemy);
        }
        // // Profiler.pop("CombatTracker: registering enemies");

        // // Profiler.push();
        precomputeThreatCombos();
        // // Profiler.pop("CombatTracker: precomputing threat combos");
    }

    public static void resetEnemyCounts() {
        {% for s in moveShort %}
        low{{ s }} = 0L;
        {% endfor %}
        {% for s in moveShort %}
        high{{ s }} = 0L;
        {% endfor %}
    }

    private static void precomputeThreatCombos() {
        {% for mi in range(moveShort|length) %}
        {
            long low = low{{ moveShort[mi] }};
            long high = high{{ moveShort[mi] }};
            long threat = moveThreat{{ moveShort[mi] }};
            long combined;
            {% for fi in range(shortDirections|length) %}
            combined = high + (low & hidden{{ shortDirections[fi] }});
            threat{{ moveShort[mi] }}{{ shortDirections[fi] }} = combined & threat;
            {% endfor %}
        }
        {% endfor %}
    }

    public static boolean hasAnyThreat(Direction moveDir) {
        switch (moveDir.ordinal()) {
            {% for mi in range(moveShort|length) %}
            case {{ mi }} -> {
                long comb = low{{ moveShort[mi] }} + high{{ moveShort[mi] }};
                return (comb & moveThreat{{ moveShort[mi] }}) != 0L;
            }
            {% endfor %}
            default -> { return false; }
        }
    }

    // TODO: account for dirt
    public static void loadThreatFromMap() throws GameActionException {
        int x = myLoc.x;
        int y = myLoc.y;
        {% for dy in range(2, -3, -1) %}
        {% for dx in range(-2, 3) %}
        {%- if dx == 0 and dy == 0 %}
        {{ cell_var(dx, dy) }} = true;
        {%- else %}
        {%- set ns = namespace(conds=[]) -%}
        {%- if dx < 0 -%}
        {%- set ns.conds = ns.conds + ["x >= " ~ (-dx)] -%}
        {%- elif dx > 0 -%}
        {%- set ns.conds = ns.conds + ["x < mapWidth - " ~ dx] -%}
        {%- endif -%}
        {%- if dy < 0 -%}
        {%- set ns.conds = ns.conds + ["y >= " ~ (-dy)] -%}
        {%- elif dy > 0 -%}
        {%- set ns.conds = ns.conds + ["y < mapHeight - " ~ dy] -%}
        {%- endif -%}
        {%- if ns.conds|length > 0 -%}
        {{ cell_var(dx, dy) }} = ({{ ns.conds | join(" && ") }}) && CellTracker.mapData[y {% if dy %} + {{dy}}{% endif %}].charAt(x {% if dx %} + {{dx}}{% endif %}) != '\2';
        {%- else -%}
        {{ cell_var(dx, dy) }} = CellTracker.mapData[y {% if dy %} + {{dy}}{% endif %}].charAt(x {% if dx %} + {{dx}}{% endif %}) != '\2';
        {%- endif -%}
        {%- endif %}
        {% endfor %}
        {% endfor %}
    }

